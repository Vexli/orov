# Copy to apps/web/.env.local for local development. Never commit real values.
# Every setting is described in docs/configuration.md.

DATABASE_URL=postgres://orov:orov@localhost:5432/orov

AUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string

# Only accounts with an email on this domain can sign in.
COMPANY_DOMAIN=example.com

# Comma-separated. These accounts are promoted to admin on their next sign-in.
ADMIN_EMAILS=you@example.com

# --- Single sign-on -------------------------------------------------------------------------
# Comma-separated list of: google, microsoft-entra-id, okta, cognito, oidc. Each one you list
# needs its own variables below. The callback URL to register with the identity provider is
# $AUTH_URL/api/auth/callback/<provider>, e.g. http://localhost:3000/api/auth/callback/google
AUTH_PROVIDERS=google

# Google Workspace. Sign-in also requires the account's hd claim to equal COMPANY_DOMAIN.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID (Azure AD). The issuer must name your tenant; /common/, /organizations/
# and /consumers/ are refused. The app registration must include the optional `email` claim.
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Okta
# AUTH_OKTA_ID=
# AUTH_OKTA_SECRET=
# AUTH_OKTA_ISSUER=https://<your-org>.okta.com

# AWS Cognito user pool (also how to federate AWS IAM Identity Center or another SAML IdP)
# AUTH_COGNITO_ID=
# AUTH_COGNITO_SECRET=
# AUTH_COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>

# Any other OpenID Connect provider (Auth0, Keycloak, OneLogin, JumpCloud, PingOne, ...)
# AUTH_OIDC_NAME=Acme SSO
# AUTH_OIDC_ID=
# AUTH_OIDC_SECRET=
# AUTH_OIDC_ISSUER=https://sso.example.com

# --- Local development only -----------------------------------------------------------------
# Ignored unless the app runs under `next dev` with a localhost AUTH_URL, so they have no effect
# in a production build or deployment. Emails must still be on COMPANY_DOMAIN.
#
# Shows an email + password form on /login. Any company email works with this password, which
# lets you sign in as different people (an ADMIN_EMAILS address for admin, anyone else as viewer).
# AUTH_DEV_PASSWORD=dev
#
# Skips the login page: signed-out requests are signed in as this email automatically.
# AUTH_DEV_BYPASS_EMAIL=you@example.com

# --- Theme (optional) -----------------------------------------------------------------------
# The theme served until an admin applies one on the Branding page: a DTCG token file whose
# token paths are slot names, such as a theme exported from that page. Unset, OrOv's own
# defaults are used (theme/default.tokens.json). See docs/theming.md.
# THEME_TOKENS_PATH=/etc/orov/brand.tokens.json

# --- Integrations (optional) ----------------------------------------------------------------
# Chat/messaging, calendar and room-status providers. Each defaults to none: the feature is
# hidden and its jobs don't run. No real provider ships yet; see docs/integrations/README.md.
# The worker reads these and refuses to start with an unknown provider id.
# MESSAGING_PROVIDER=none
# CALENDAR_PROVIDER=none
# ROOMS_PROVIDER=none
#
# Use the in-memory fakes for all three, overriding the variables above (offline development).
# INTEGRATIONS=fake
