# Copy to .env.local for local development. Never commit real values.

DATABASE_URL=postgres://officeorg:officeorg@localhost:5432/officeorg

# Google sign-in (Auth.js). The OAuth client must allow http://localhost:3000/api/auth/callback/google
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only accounts on this Workspace domain can sign in.
COMPANY_DOMAIN=example.com

# Comma-separated. These accounts are promoted to admin on their next sign-in.
ADMIN_EMAILS=you@example.com
