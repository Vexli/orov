{
  "name": "orov",
  "private": true,
  "license": "MIT-0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @orov/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @orov/db db:generate",
    "db:migrate": "pnpm --filter @orov/db db:migrate",
    "db:seed": "pnpm --filter @orov/db db:seed",
    "demo:build": "pnpm --filter @orov/db demo:build",
    "theme:defaults": "pnpm --filter @orov/web theme:defaults",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@orov/core": "workspace:*",
    "@orov/db": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.1",
    "better-call": "1.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
